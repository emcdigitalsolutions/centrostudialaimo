---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Pagina non trovata" noindex>
  <PageHero eyebrow="Errore 404" title={`Questa pagina <em class="serif" style="color:var(--c-amber)">non c’è</em>.`} lead="Forse il corso è stato spostato o il collegamento non è corretto. Cerca tra tutti i corsi o torna alla home." crumbs={[{ label: 'Pagina non trovata' }]}>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px">
      <button class="btn btn--amber" data-search-open><Icon name="search" /> Cerca un corso</button>
      <a class="btn btn--ghost-light" href="/">Torna alla home</a>
    </div>
  </PageHero>
</Base>
