---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import MailForm from '../../components/MailForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
const uses = [
  { icon: 'target', t: 'Accedere a una classe di concorso', d: 'Integra gli esami e i CFU mancanti richiesti dalle tabelle ministeriali per insegnare una disciplina.' },
  { icon: 'landmark', t: 'Partecipare a concorsi pubblici', d: 'Acquisisci i crediti richiesti da bandi e concorsi che prevedono specifici settori disciplinari.' },
  { icon: 'grad', t: 'Prepararti a una magistrale', d: 'Colma i requisiti curriculari per l’accesso a una laurea magistrale senza ripartire da zero.' },
  { icon: 'spark', t: 'Aggiornarti', d: 'Approfondisci una materia di tuo interesse con un esame universitario certificato.' },
];
---
<Base title="Corsi singoli universitari online" description="Iscriviti a singoli insegnamenti universitari online e sostieni l’esame: per integrare CFU per le classi di concorso, i concorsi pubblici o l’accesso a una laurea magistrale." keywords="corsi singoli universitari, esami singoli online, integrare CFU, CFU classe di concorso, corsi singoli università telematica">
  <PageHero
    eyebrow="Università"
    title={`Corsi singoli: <em class="serif" style="color:var(--c-amber)">solo gli esami che ti servono</em>`}
    lead="Iscriviti a singoli insegnamenti universitari e sostieni i relativi esami, con la certificazione dell’attività svolta e dei CFU acquisiti."
    crumbs={[{ label: 'Università', href: '/universita/' }, { label: 'Corsi singoli' }]}
  />
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal><p class="eyebrow">A cosa servono</p><h2>Crediti mirati, tempi brevi</h2></div>
      <div class="uses">
        {uses.map((u, i) => <div class="use" data-reveal style={`--d:${i}`}><Icon name={u.icon} size={28} /><h3>{u.t}</h3><p>{u.d}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section section--white">
    <div class="wrap narrow">
      <p class="eyebrow">Richiedi informazioni</p>
      <h2>Dicci quali CFU ti servono</h2>
      <p class="lead">Indica la classe di concorso o il requisito da raggiungere e gli esami già sostenuti: individuiamo gli insegnamenti giusti tra quelli attivi.</p>
      <MailForm course="Corsi singoli universitari" id="singoli" />
    </div>
  </section>
  <CtaBand variant="cfu" />
</Base>

<style>
  .uses { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .use { padding: 26px; border-radius: var(--r); background: #fff; box-shadow: var(--shadow-sm); color: var(--c-blue); }
  .use h3 { margin: 16px 0 8px; font-size: 1.15rem; }
  .use p { color: var(--c-muted); margin: 0; }
  .narrow { max-width: 820px; }
  .lead { color: var(--c-muted); font-size: 1.1rem; }
  @media (max-width: 1000px) { .uses { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .uses { grid-template-columns: minmax(0, 1fr); } }
</style>
