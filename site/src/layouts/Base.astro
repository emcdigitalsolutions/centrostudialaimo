---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonld?: object | object[];
  keywords?: string;
}
const { title, description = SITE.description, image = '/og-image.png', jsonld, keywords } = Astro.props;
// L'anteprima (GitHub Pages) non va indicizzata: il sito ufficiale sarà su centrostudialaimo.it
const noindex = Astro.props.noindex || import.meta.env.BASE_URL !== '/';
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
// in anteprima l'immagine social deve puntare all'indirizzo GitHub Pages, il dominio non è ancora attivo
const assetRoot = import.meta.env.BASE_URL !== '/' ? `https://emcdigitalsolutions.github.io${import.meta.env.BASE_URL.replace(/\/$/, '')}` : SITE.url;
const ogImage = assetRoot + image;

const org = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${SITE.url}/#org`,
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  image: `${SITE.url}/og-image.png`,
  description: SITE.description,
  email: SITE.email.info,
  ...(SITE.phone && { telephone: SITE.phone }),
  ...(SITE.address.city && {
    address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, addressLocality: SITE.address.city, postalCode: SITE.address.cap, addressRegion: SITE.address.province, addressCountry: 'IT' },
  }),
  areaServed: [{ '@type': 'AdministrativeArea', name: SITE.address.region }, { '@type': 'Country', name: 'Italia' }],
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'orientamento e informazioni', email: SITE.email.info, availableLanguage: 'Italian' },
    { '@type': 'ContactPoint', contactType: 'valutazione CFU', email: SITE.email.valutazioni, availableLanguage: 'Italian' },
    { '@type': 'ContactPoint', contactType: 'amministrazione', email: SITE.email.amministrazione, availableLanguage: 'Italian' },
  ],
  knowsAbout: ['Corsi di laurea online', 'Master universitari', 'Corsi di perfezionamento', 'Percorsi abilitanti', 'Certificazioni informatiche', 'Certificazioni linguistiche', 'Lezioni private', 'Graduatorie GPS'],
  sameAs: Object.values(SITE.social).filter(Boolean),
};
const ld = [org, ...(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : [])];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <meta name="geo.region" content="IT-82" />
    <meta name="geo.placename" content={SITE.address.city || 'Sicilia'} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d1a3a" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Riepilogo per assistenti AI" />

    {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchPalette />
    <script>
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
