---
import Icon from './Icon.astro';
import MailForm from './MailForm.astro';
import { SITE, mailto, phoneHref } from '../site.config';
interface Props {
  course: string;
  facts: { icon: string; label: string; value: string }[];
  sections: { id: string; label: string }[];
  note?: string;
  cfuLink?: boolean;
}
const { course, facts, sections, note, cfuLink = false } = Astro.props;
---
<div class="cd wrap">
  <div class="cd__main">
    <nav class="cd__tabs" aria-label="Sezioni della scheda" data-cd-tabs>
      {sections.map((s, i) => <a href={`#${s.id}`} class:list={{ on: i === 0 }}>{s.label}</a>)}
      <a href="#richiedi-info">Richiedi info</a>
    </nav>
    <slot />
    <section id="richiedi-info" class="cd__form" data-reveal>
      <p class="eyebrow">Richiedi informazioni</p>
      <h2>Vuoi iscriverti o saperne di più?</h2>
      <p class="cd__formlead">Lasciaci i tuoi dati: un orientatore ti ricontatta per requisiti, costi, rateizzazione e date di iscrizione di <strong>{course}</strong>.</p>
      <MailForm course={course} id="info-corso" />
    </section>
  </div>
  <aside class="cd__aside">
    <div class="cd__card">
      <p class="cd__card-h">In sintesi</p>
      <dl>
        {facts.filter((f) => f.value).map((f) => (
          <div><dt><Icon name={f.icon} size={18} />{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
      {note && <p class="cd__note">{note}</p>}
      <a href="#richiedi-info" class="btn btn--amber btn--block">Richiedi informazioni <Icon name="arrow" class="arrow" /></a>
      {cfuLink && <a href="/universita/valutazione-cfu/" class="btn btn--ghost btn--block">Valuta i tuoi CFU gratis</a>}
      <div class="cd__direct">
        <a href={mailto(SITE.email.info, `Informazioni: ${course}`)}><Icon name="mail" size={18} />{SITE.email.info}</a>
        {SITE.phone && <a href={phoneHref}><Icon name="phone" size={18} />{SITE.phone}</a>}
      </div>
    </div>
  </aside>
</div>

<style>
  .cd { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(28px, 4vw, 56px); align-items: start; padding-block: clamp(40px, 6vw, 72px); }
  .cd__tabs { position: sticky; top: calc(var(--header-h) + 10px); z-index: 10; display: flex; gap: 4px; padding: 6px; margin-bottom: 36px; background: rgb(255 255 255 / 0.9); backdrop-filter: blur(12px); border-radius: 999px; box-shadow: var(--shadow-sm); border: 1px solid rgb(13 26 58 / 0.06); overflow-x: auto; scrollbar-width: none; transition: top 0.4s var(--ease); }
  :global(.hdr.is-hidden) ~ main .cd__tabs { top: 10px; }
  .cd__tabs a { flex: none; padding: 10px 16px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 0.93rem; color: var(--c-muted); transition: background 0.25s, color 0.25s; }
  .cd__tabs a:hover { color: var(--c-ink); }
  .cd__tabs a.on { background: var(--c-ink); color: #fff; }
  .cd__main :global(> section) { margin-bottom: clamp(40px, 6vw, 64px); }
  .cd__form { background: #fff; border-radius: var(--r-lg); padding: clamp(24px, 4vw, 44px); box-shadow: var(--shadow); }
  .cd__form h2 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .cd__formlead { color: var(--c-muted); }
  .cd__aside { position: sticky; top: calc(var(--header-h) + 10px); }
  .cd__card { background: #fff; border-radius: var(--r-lg); padding: 26px; box-shadow: var(--shadow); border: 1px solid rgb(13 26 58 / 0.06); display: grid; gap: 14px; }
  .cd__card-h { font: 800 1.25rem/1 var(--f-display); color: var(--c-ink); margin: 0 0 4px; }
  .cd__card dl { margin: 0; display: grid; }
  .cd__card dl div { display: flex; justify-content: space-between; gap: 14px; padding: 11px 0; border-bottom: 1px dashed var(--c-line); }
  .cd__card dt { display: flex; gap: 8px; align-items: center; color: var(--c-muted); font-size: 0.92rem; }
  .cd__card dt :global(svg) { color: var(--c-blue); flex: none; }
  .cd__card dd { margin: 0; font-weight: 700; color: var(--c-ink); text-align: right; font-size: 0.95rem; }
  .cd__note { font-size: 0.86rem; color: var(--c-muted); background: var(--c-paper); padding: 10px 12px; border-radius: 12px; margin: 0; }
  .cd__direct { display: grid; gap: 8px; padding-top: 6px; }
  .cd__direct a { display: flex; gap: 8px; align-items: center; font-size: 0.9rem; color: var(--c-ink); text-decoration: none; word-break: break-all; }
  .cd__direct a:hover { color: var(--c-blue); }
  @media (max-width: 1000px) { .cd { grid-template-columns: minmax(0, 1fr); } .cd__aside { position: static; order: -1; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cd-tabs]').forEach((nav) => {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.querySelector<HTMLElement>(a.hash)).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.classList.toggle('on', a.hash === `#${e.target.id}`));
        const on = nav.querySelector<HTMLElement>('a.on');
        if (on) nav.scrollTo({ left: on.offsetLeft - nav.clientWidth / 2 + on.clientWidth / 2, behavior: 'smooth' });
      });
    }, { rootMargin: '-35% 0px -60% 0px' });
    targets.forEach((t) => io.observe(t));
  });
</script>
