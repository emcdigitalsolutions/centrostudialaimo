---
// Modulo che apre il programma di posta dell'utente (mailto): il sito non invia né conserva dati.
import Icon from './Icon.astro';
import { SITE } from '../site.config';
import { lauree } from '../lib/catalog';
interface Props { kind?: 'info' | 'cfu' | 'lezioni'; course?: string; compact?: boolean; id?: string }
const { kind = 'info', course = '', compact = false, id = 'modulo' } = Astro.props;
const to = kind === 'cfu' ? SITE.email.valutazioni : SITE.email.info;
const subject = kind === 'cfu' ? 'Richiesta valutazione CFU' : kind === 'lezioni' ? 'Richiesta lezioni private' : course ? `Informazioni: ${course}` : 'Richiesta informazioni';
const interessi = ['Corso di laurea', 'Master', 'Corso di perfezionamento', 'Percorso abilitante', 'Certificazione informatica', 'Certificazione linguistica', 'Corso regionale', 'Lezioni private', 'Altro'];
---
<form class:list={['mf', { 'mf--compact': compact }]} id={id} data-mailform data-to={to} data-subject={subject} novalidate>
  <div class="form-grid">
    <div class="field"><label for={`${id}-nome`}>Nome e cognome *</label><input id={`${id}-nome`} name="Nome" required autocomplete="name" /></div>
    <div class="field"><label for={`${id}-tel`}>Telefono</label><input id={`${id}-tel`} name="Telefono" type="tel" autocomplete="tel" inputmode="tel" /></div>
    {!compact && <div class="field full"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="Email" type="email" autocomplete="email" /></div>}
    {course ? (
      <input type="hidden" name="Corso" value={course} />
    ) : kind === 'cfu' ? (
      <>
        <div class="field"><label for={`${id}-titolo`}>Titolo di studio attuale *</label>
          <select id={`${id}-titolo`} name="Titolo di studio" required>
            <option value="">Seleziona…</option>
            <option>Diploma (con esami universitari sostenuti)</option><option>Laurea triennale</option><option>Laurea magistrale / vecchio ordinamento</option><option>Carriera universitaria interrotta</option><option>Decaduto / rinunciatario</option>
          </select></div>
        <div class="field"><label for={`${id}-ateneo`}>Università di provenienza</label><input id={`${id}-ateneo`} name="Università di provenienza" placeholder="Es. Università di Palermo" /></div>
        <div class="field full"><label for={`${id}-corso`}>Corso di laurea che ti interessa *</label>
          <input id={`${id}-corso`} name="Corso di interesse" required list={`${id}-lauree`} placeholder="Inizia a scrivere: Psicologia, Ingegneria…" />
          <datalist id={`${id}-lauree`}>{lauree.map((l) => <option value={l.title} />)}</datalist></div>
      </>
    ) : (
      <div class="field full"><label for={`${id}-int`}>Ti interessa</label>
        <select id={`${id}-int`} name="Interesse">{(kind === 'lezioni' ? ['Ripetizioni scuola media', 'Ripetizioni scuola superiore', 'Preparazione esami universitari', 'Tesi di laurea', 'Preparazione concorsi', 'Recupero anni scolastici', 'Altro'] : interessi).map((i) => <option>{i}</option>)}</select></div>
    )}
    <div class="field full"><label for={`${id}-msg`}>{kind === 'cfu' ? 'Esami già sostenuti (o note)' : 'Messaggio'}</label>
      <textarea id={`${id}-msg`} name="Messaggio" placeholder={kind === 'cfu' ? 'Elenca gli esami con voto e CFU, oppure scrivi che allegherai il piano di studi o l’autocertificazione alla mail.' : 'Raccontaci il tuo obiettivo: ti ricontattiamo con una proposta su misura.'}></textarea></div>
    <label class="check full"><input type="checkbox" required name="privacy" /> <span>Ho letto l’<a href="/privacy/">informativa privacy</a> *</span></label>
    <div class="full mf__actions">
      <button class="btn btn--blue" type="submit"><Icon name="mail" /> Scrivi con la tua email</button>
      <p class="form-note">Si apre il tuo programma di posta con il messaggio già compilato{kind === 'cfu' && ': puoi allegare il piano di studi'}. Il sito non invia né conserva i tuoi dati.</p>
    </div>
    <p class="form-ok full" data-ok role="status">Abbiamo aperto il tuo programma di posta: premi «Invia» per completare. Se non si è aperto, scrivi direttamente a <a href={`mailto:${to}`}>{to}</a>.</p>
  </div>
</form>

<style>
  .mf__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; }
  .mf__actions .form-note { flex: 1 1 240px; }
  .mf--compact .mf__actions { flex-direction: column; align-items: stretch; }
  .mf--compact .btn { width: 100%; }
  .mf--compact .form-grid { grid-template-columns: minmax(0, 1fr); }
  .mf .err { border-color: var(--c-coral) !important; box-shadow: 0 0 0 4px var(--c-coral-soft) !important; }
  .check a { color: var(--c-blue); }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-mailform]').forEach((f) => {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = true;
      f.querySelectorAll<HTMLInputElement>('[required]').forEach((el) => {
        const bad = el.type === 'checkbox' ? !el.checked : !el.value.trim();
        (el.type === 'checkbox' ? el.parentElement! : el).classList.toggle('err', bad);
        if (bad && ok) { ok = false; el.focus(); }
      });
      if (!ok) return;
      const lines: string[] = [];
      new FormData(f).forEach((v, k) => { if (k !== 'privacy' && String(v).trim()) lines.push(`${k}: ${v}`); });
      const body = `Buongiorno,\n\n${lines.join('\n')}\n\nGrazie.`;
      const href = `mailto:${f.dataset.to}?subject=${encodeURIComponent(f.dataset.subject!)}&body=${encodeURIComponent(body)}`;
      window.location.href = href;
      f.querySelector('[data-ok]')!.classList.add('show');
    });
  });
</script>
