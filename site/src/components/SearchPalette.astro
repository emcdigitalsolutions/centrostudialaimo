---
import Icon from './Icon.astro';
import { STATS } from '../lib/catalog';
---
<dialog class="sp" data-sp aria-label="Cerca un corso">
  <div class="sp__box">
    <div class="sp__bar">
      <Icon name="search" size={22} />
      <input type="search" placeholder={`Cerca tra ${STATS.totale}+ corsi: laurea, master, CLIL, sostegno…`} autocomplete="off" spellcheck="false" data-sp-input aria-label="Cerca" />
      <button class="sp__close" data-sp-close aria-label="Chiudi la ricerca"><kbd>Esc</kbd></button>
    </div>
    <div class="sp__hint" data-sp-hint>
      <p>Ricerche frequenti</p>
      <div class="sp__sugg">
        {['Sostegno', 'Psicologia', 'CLIL', 'Infermiere', 'Ingegneria informatica', 'Pubblica amministrazione', 'Inglese C1', 'DSGA', 'Criminologia'].map((s) => (
          <button type="button" class="chip" data-sp-sugg={s}>{s}</button>
        ))}
      </div>
    </div>
    <ul class="sp__list" data-sp-list role="listbox"></ul>
    <p class="sp__empty" data-sp-empty hidden>Nessun corso trovato. <a href="/contatti/">Scrivici</a>: ti aiutiamo a trovare il percorso giusto.</p>
    <div class="sp__foot"><span><kbd>↑</kbd><kbd>↓</kbd> per scegliere</span><span><kbd>Invio</kbd> per aprire</span></div>
  </div>
</dialog>

<style>
  .sp { padding: 0; border: 0; background: transparent; width: min(100% - 24px, 720px); max-height: none; margin: 10vh auto auto; overflow: visible; }
  .sp::backdrop { background: rgb(13 26 58 / 0.55); backdrop-filter: blur(6px); }
  .sp[open] .sp__box { animation: spin 0.35s var(--ease); }
  @keyframes spin { from { opacity: 0; transform: translateY(-12px) scale(0.98); } }
  .sp__box { background: #fff; border-radius: 22px; box-shadow: var(--shadow-lg); overflow: hidden; }
  .sp__bar { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--c-line); color: var(--c-blue); }
  .sp__bar input { flex: 1; border: 0; outline: none; font: 500 1.1rem/1.4 var(--f-body); color: var(--c-ink); min-width: 0; background: none; }
  .sp__bar input::-webkit-search-cancel-button { display: none; }
  .sp__close { border: 0; background: none; padding: 0; }
  kbd { font: 600 0.72rem/1 var(--f-body); padding: 4px 7px; border-radius: 6px; background: var(--c-paper-2); color: var(--c-muted); border: 1px solid var(--c-line); }
  .sp__hint { padding: 18px; }
  .sp__hint p { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--c-muted); font-weight: 700; margin-bottom: 10px; }
  .sp__sugg { display: flex; flex-wrap: wrap; gap: 8px; }
  .sp__sugg .chip { border: 0; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .sp__sugg .chip:hover { background: var(--c-blue); color: #fff; }
  .sp__list { list-style: none; margin: 0; padding: 8px; max-height: min(56vh, 520px); overflow-y: auto; }
  .sp__list:empty { display: none; }
  .sp__list :global(a) { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 11px 14px; border-radius: 12px; text-decoration: none; color: var(--c-text); }
  .sp__list :global(a.sel) { background: var(--c-blue-soft); }
  .sp__list :global(.t) { font-weight: 600; color: var(--c-ink); line-height: 1.3; }
  .sp__list :global(.t mark) { background: var(--c-amber-soft); color: inherit; border-radius: 3px; }
  .sp__list :global(.k) { grid-row: span 2; align-self: center; font-size: 0.75rem; font-weight: 700; color: var(--c-blue); background: var(--c-blue-soft); padding: 4px 9px; border-radius: 999px; white-space: nowrap; }
  .sp__list :global(a.sel .k) { background: #fff; }
  .sp__list :global(.m) { font-size: 0.84rem; color: var(--c-muted); }
  .sp__empty { padding: 22px 18px; color: var(--c-muted); margin: 0; }
  .sp__foot { display: flex; gap: 18px; padding: 10px 18px; border-top: 1px solid var(--c-line); font-size: 0.8rem; color: var(--c-muted); background: var(--c-paper); }
  .sp__foot kbd { margin-right: 3px; }
  @media (max-width: 640px) { .sp { margin-top: 12px; } .sp__foot { display: none; } .sp__list :global(a) { grid-template-columns: minmax(0, 1fr); } .sp__list :global(.k) { grid-row: auto; justify-self: start; } }
</style>

<script>
  type Item = { t: string; u: string; k: string; m: string; n?: string };
  const dlg = document.querySelector<HTMLDialogElement>('[data-sp]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-sp-input]')!;
  const list = dlg.querySelector<HTMLUListElement>('[data-sp-list]')!;
  const hint = dlg.querySelector<HTMLElement>('[data-sp-hint]')!;
  const empty = dlg.querySelector<HTMLElement>('[data-sp-empty]')!;
  let data: Item[] | null = null;
  let sel = 0;
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[’'`]/g, ' ');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  async function load() {
    if (data) return;
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const r = await fetch(`${base}/search.json`);
    data = ((await r.json()) as Item[]).map((i) => ({ ...i, u: base + i.u, n: norm(`${i.t} ${i.k} ${i.m}`) }));
  }
  function render() {
    const q = norm(input.value.trim());
    hint.hidden = !!q;
    if (!q || !data) { list.innerHTML = ''; empty.hidden = true; return; }
    const words = q.split(/\s+/).filter(Boolean);
    const res = data
      .map((i) => {
        if (!words.every((w) => i.n!.includes(w))) return null;
        const tn = norm(i.t);
        let s = 0;
        for (const w of words) { if (tn.startsWith(w)) s += 6; else if (new RegExp(`\\b${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`).test(tn)) s += 4; else if (tn.includes(w)) s += 2; }
        return { i, s: s - tn.length / 200 };
      })
      .filter(Boolean)
      .sort((a, b) => b!.s - a!.s)
      .slice(0, 40) as { i: Item }[];
    empty.hidden = res.length > 0;
    sel = 0;
    const hl = (t: string) => {
      let out = esc(t);
      for (const w of words) {
        const tn = norm(t);
        const idx = tn.indexOf(w);
        if (idx >= 0 && words.length === 1) out = esc(t.slice(0, idx)) + '<mark>' + esc(t.slice(idx, idx + w.length)) + '</mark>' + esc(t.slice(idx + w.length));
      }
      return out;
    };
    list.innerHTML = res.map(({ i }, n) => `<li role="option"><a href="${i.u}" class="${n === 0 ? 'sel' : ''}"><span class="t">${hl(i.t)}</span><span class="k">${esc(i.k)}</span><span class="m">${esc(i.m)}</span></a></li>`).join('');
  }
  function move(d: number) {
    const links = [...list.querySelectorAll('a')];
    if (!links.length) return;
    links[sel]?.classList.remove('sel');
    sel = (sel + d + links.length) % links.length;
    links[sel].classList.add('sel');
    links[sel].scrollIntoView({ block: 'nearest' });
  }
  async function openSp(q = '') {
    document.querySelector('[data-hdr]')?.classList.remove('drawer-open');
    document.documentElement.style.overflow = '';
    dlg.showModal();
    input.value = q;
    input.focus();
    await load();
    render();
  }
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', () => openSp((b as HTMLElement).dataset.q || '')));
  document.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement;
    if (f.matches('[data-search-form]')) { e.preventDefault(); openSp((f.querySelector('input') as HTMLInputElement).value); }
  });
  addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : openSp(); }
    else if (e.key === '/' && !dlg.open && !/input|textarea|select/i.test((e.target as HTMLElement).tagName)) { e.preventDefault(); openSp(); }
  });
  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') { const a = list.querySelectorAll('a')[sel]; if (a) location.href = a.getAttribute('href')!; }
  });
  dlg.querySelector('[data-sp-close]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.querySelectorAll<HTMLButtonElement>('[data-sp-sugg]').forEach((b) => b.addEventListener('click', () => { input.value = b.dataset.spSugg!; render(); input.focus(); }));
</script>
