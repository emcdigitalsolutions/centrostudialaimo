---
import Icon from './Icon.astro';
interface Props { tiles: { href: string; icon: string; title: string; text: string; tag?: string; color?: string }[] }
const { tiles } = Astro.props;
---
<div class="hub">
  {tiles.map((t, i) => (
    <a href={t.href} class="tile" style={`--accent:${t.color ?? 'var(--c-blue)'};--d:${i % 3}`} data-reveal>
      <span class="tile__ic"><Icon name={t.icon} size={28} /></span>
      {t.tag && <span class="tile__tag">{t.tag}</span>}
      <h3>{t.title}</h3>
      <p>{t.text}</p>
      <span class="tile__go">Vai ai corsi <Icon name="arrow" size={18} /></span>
    </a>
  ))}
</div>

<style>
  .hub { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .tile { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 28px; min-height: 270px; border-radius: var(--r-lg); background: #fff; text-decoration: none; color: inherit; box-shadow: var(--shadow-sm); overflow: hidden; isolation: isolate; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), color 0.4s; }
  .tile::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 100% 0%, var(--accent), var(--c-ink) 75%); opacity: 0; transition: opacity 0.5s var(--ease); }
  .tile:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); color: #c9d1e6; }
  .tile:hover::before { opacity: 1; }
  .tile:hover h3 { color: #fff; }
  .tile__ic { width: 58px; height: 58px; border-radius: 18px; display: grid; place-items: center; background: var(--accent); color: #fff; margin-bottom: 12px; transition: transform 0.5s var(--ease); }
  .tile:hover .tile__ic { transform: rotate(-8deg) scale(1.06); background: rgb(255 255 255 / 0.15); }
  .tile__tag { position: absolute; top: 26px; right: 24px; font: 700 0.75rem/1 var(--f-body); padding: 6px 10px; border-radius: 999px; background: var(--c-paper); color: var(--c-ink); }
  .tile h3 { font-size: 1.4rem; margin: 0; transition: color 0.4s; }
  .tile p { margin: 0; color: inherit; opacity: 0.85; font-size: 0.98rem; }
  .tile__go { margin-top: auto; padding-top: 16px; display: inline-flex; gap: 8px; align-items: center; font-weight: 700; color: var(--accent); }
  .tile:hover .tile__go { color: var(--c-amber); }
  .tile__go :global(svg) { transition: transform 0.35s var(--ease); }
  .tile:hover .tile__go :global(svg) { transform: translateX(5px); }
  @media (max-width: 960px) { .hub { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .hub { grid-template-columns: minmax(0, 1fr); } .tile { min-height: 0; } }
</style>
